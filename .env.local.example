# Sanity Studio / CMS (optional — the site runs on static, document-sourced
# content in /data until these are set). Create a project at sanity.io/manage,
# then copy this file to .env.local and fill in the values.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Editor token, used only by scripts/seed.ts (npm run seed). Never expose
# this publicly or commit it.
SANITY_API_TOKEN=

# Base URL used for metadata / sitemap generation
NEXT_PUBLIC_SITE_URL=https://www.prestige.sn
